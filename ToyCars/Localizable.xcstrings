    "The blue arrows on the track give a short boost. Ramps cut the route short." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modré šipky na trati dají krátké zrychlení. Skokánky zkracují cestu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The blue arrows on the track give a short boost. Ramps cut the route short."
          }
        }
      }
    },
    "The car handles the throttle itself. You take care of the corners, the brake and the drift." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyn přidává autíčko samo. Ty řešíš zatáčky, brzdu a smyk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The car handles the throttle itself. You take care of the corners, the brake and the drift."
          }
        }
      }
    },
    "The drift button pays off in hairpins, not in fast bends." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smyk se vyplatí ve vlásenkách, ne v rychlých zatáčkách."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The drift button pays off in hairpins, not in fast bends."
          }
        }
      }
    },
    "The purple button lets the rear end slide. In tight corners that is faster." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fialové tlačítko pustí zadek auta do smyku. V ostrých zatáčkách je to rychlejší."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purple button lets the rear end slide. In tight corners that is faster."
          }
        }
      }
    },
    "The throttle is automatic and fuel drains away. Collect the red canisters on the track or you will not make it." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plyn jede sám a palivo ubývá. Sbírej červené kanystry na trati, jinak nedojedeš."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The throttle is automatic and fuel drains away. Collect the red canisters on the track or you will not make it."
          }
        }
      }
    },
